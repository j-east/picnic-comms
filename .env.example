# Copy to .env for local dev. In Coolify these are app env vars.
PORT=3000
# Where tokens, state, glossary live (a persistent volume in Coolify)
DATA_DIR=./data
# Public URL of this deployment (OAuth redirect + links in mail)
PUBLIC_URL=http://localhost:3000
# Long random string; Yeva's login link is PUBLIC_URL/login/<APP_TOKEN>
APP_TOKEN=change-me
# Google OAuth web client (Internal app under the Workspace org)
# Optional until the OAuth client exists; Gmail can't be connected without them
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The mailbox this instance serves
MAILBOX=chic@picnicpartyjacksonville.com
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Poll interval in seconds
POLL_SECONDS=120
# Set to 1 to run the poll loop inside the web process (default on)
POLL_ENABLED=1
