{
  "name": "picnic-comms",
  "version": "0.1.0",
  "private": true,
  "description": "Ukrainian-first email comms for Picnic Party Jacksonville: reads and drafts in Ukrainian, clients get native English, nothing sends without her tap.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p .",
    "build:web": "cd web && npm run build",
    "start": "node dist/index.js",
    "test": "node --test --import tsx src/**/*.test.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.0",
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
